---
/**
 * Call-to-action button. Renders an <a> when `href` is given, otherwise a <button>.
 *
 * Props:
 * - variant: "primary" (filled orange) or "secondary" (outlined). Default "primary".
 * - href: optional link target (already passed through `url()` or an external URL).
 * - class: extra classes; `is-hover` / `is-focus-visible` force a state for /styleguide/.
 */
interface Props {
  variant?: 'primary' | 'secondary';
  href?: string;
  class?: string;
}

const { variant = 'primary', href, class: className } = Astro.props;
const Element = href ? 'a' : 'button';
---

<Element
  class:list={['btn', variant, className]}
  href={href}
  type={href ? undefined : 'button'}
>
  <slot />
</Element>

<style>
  .btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem; /* 44px touch target */
    padding: var(--space-2) var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius);
    font: 500 var(--fs-small) / 1 var(--font-sans);
    text-decoration: none;
    cursor: pointer;
  }

  /* Hover/selected affordances animate opacity only (never colour or border). */
  .btn::before,
  .btn::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .btn::before {
    z-index: -1;
    background: var(--text);
  }
  .btn::after {
    border: 1px solid var(--accent);
  }

  .primary {
    background: var(--accent);
    color: var(--bg);
  }
  .primary:is(:hover, .is-hover)::before {
    opacity: 0.16;
  }

  .secondary {
    border-color: var(
      --text-muted
    ); /* --navy-line is only 1.5:1, too faint for a control edge */
    color: var(--text);
  }
  .secondary:is(:hover, .is-hover)::after {
    opacity: 1;
  }
</style>
