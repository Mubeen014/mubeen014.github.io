---
/**
 * Call-to-action button. Renders an <a> when `href` is given, otherwise a <button>.
 *
 * Props:
 * - variant: "primary" (filled orange) or "secondary" (outlined). Default "primary".
 * - href: optional link target (already passed through `url()` or an external URL).
 * - class: extra classes on the root element.
 */
interface Props {
  variant?: 'primary' | 'secondary';
  href?: string;
  class?: string;
}

const { variant = 'primary', href, class: className } = Astro.props;
const Element = href ? 'a' : 'button';
---

<Element
  class:list={['btn', variant, className]}
  href={href}
  type={href ? undefined : 'button'}
>
  <slot />
</Element>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem; /* 44px touch target */
    padding: var(--space-2) var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius);
    font: 500 var(--fs-small) / 1 var(--font-sans);
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--dur-color) var(--ease-out),
      border-color var(--dur-color) var(--ease-out);
  }

  .primary {
    background: var(--accent);
    color: var(--bg);
  }
  .primary:hover {
    background: var(--accent-hover);
  }

  /* --navy-line is only 1.5:1, too faint for a control edge. */
  .secondary {
    border-color: var(--text-muted);
    color: var(--text);
  }
  .secondary:hover {
    border-color: var(--accent);
  }
</style>
