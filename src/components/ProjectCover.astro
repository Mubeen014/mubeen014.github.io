---
/**
 * Project cover: the entry's real cover image when it has one, otherwise a deterministic
 * gradient seeded from its tags (decorative, hidden from assistive tech).
 *
 * Props:
 * - tags: the project's tags (seed for the gradient).
 * - cover: optional real cover image with alt text.
 * - variant: "card" (lazy, card-sized srcset) or "detail" (above the fold, prioritised).
 */
import { Image } from 'astro:assets';
import { coverGradient } from '../lib/cover-gradient';
import type { CoverImage } from '../lib/entries';

interface Props {
  tags: string[];
  cover: CoverImage | undefined;
  variant: 'card' | 'detail';
}

const { tags, cover, variant } = Astro.props;
const imageSizing = {
  card: {
    widths: [400, 800],
    sizes: '(min-width: 48rem) 24rem, 100vw',
    priority: false,
  },
  detail: {
    widths: [800, 1600],
    sizes: '(min-width: 48rem) 52rem, 100vw',
    priority: true,
  },
}[variant];
---

{cover ? (
  <Image
    class="cover"
    src={cover.src}
    alt={cover.alt}
    widths={imageSizing.widths}
    sizes={imageSizing.sizes}
    priority={imageSizing.priority}
  />
) : (
  <div
    class="cover"
    style={`background: ${coverGradient(tags)}`}
    aria-hidden="true"
  />
)}

<style>
  .cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
