---
/**
 * Fixed site header, always one row.
 * - Wide screens: brand (monogram + name), section links, and a (not yet functional) ⌘K hint.
 * - Narrow screens: monogram + a "Menu" disclosure button that toggles a dropdown with the links.
 * Transparent at the top of the page; gains a blurred --bg-raised layer once scrolled or
 * while the menu is open.
 */
import { siteConfig } from '../lib/site';
import { url } from '../lib/paths';

const links = [
  { label: 'Projects', path: '/projects/' },
  { label: 'Experience', path: '/experience/' },
  { label: 'Education', path: '/education/' },
  { label: 'Contact', path: '/#contact' },
];
const currentPath = Astro.url.pathname;
---

<header class="nav" data-nav>
  <div class="container inner">
    <a class="brand" href={url('/')} aria-label={`${siteConfig.name} — home`}>
      <span class="monogram mono" aria-hidden="true">
        {siteConfig.monogram}
      </span>
      <span class="brand-name">{siteConfig.name}</span>
    </a>
    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="nav-links"
      data-menu-button
    >
      Menu
    </button>
    <nav class="links" id="nav-links" aria-label="Primary" data-menu-panel>
      <ul>
        {links.map(({ label, path }) => (
          <li>
            <a
              href={url(path)}
              aria-current={currentPath === path ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <button
      class="hint mono"
      type="button"
      aria-disabled="true"
      title="Command palette — coming soon"
    >
      <span>Search</span>
      <kbd>⌘K</kbd>
    </button>
  </div>
</header>

<script>
  /** Scrolled-state backdrop and the narrow-screen menu disclosure for the site header. */
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const menuButton =
    nav?.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menuPanel = nav?.querySelector<HTMLElement>('[data-menu-panel]');
  const firstMenuLink = menuPanel?.querySelector<HTMLAnchorElement>('a');
  if (!nav || !menuButton || !menuPanel || !firstMenuLink) {
    throw new Error(
      'Nav script: header, menu button, panel or links not found',
    );
  }

  const updateScrolledState = () =>
    nav.toggleAttribute('data-scrolled', window.scrollY > 8);
  updateScrolledState();
  window.addEventListener('scroll', updateScrolledState, { passive: true });

  const isMenuOpen = () => menuButton.getAttribute('aria-expanded') === 'true';
  const setMenuOpen = (open: boolean) => {
    menuButton.setAttribute('aria-expanded', String(open));
    nav.toggleAttribute('data-menu-open', open);
  };

  menuButton.addEventListener('click', () => {
    const open = !isMenuOpen();
    setMenuOpen(open);
    if (open) {
      firstMenuLink.focus();
    }
  });

  nav.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isMenuOpen()) {
      setMenuOpen(false);
      menuButton.focus();
    }
  });

  // Close after choosing a link (matters for same-page links like /#contact) or tapping outside.
  menuPanel.addEventListener('click', (event) => {
    if (event.target instanceof HTMLAnchorElement) {
      setMenuOpen(false);
    }
  });
  document.addEventListener('click', (event) => {
    if (
      isMenuOpen() &&
      event.target instanceof Node &&
      !nav.contains(event.target)
    ) {
      setMenuOpen(false);
    }
  });
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    isolation: isolate;
  }

  /* Backdrop layer fades in with opacity; backdrop-filter can't be colour-transitioned. */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--bg-raised) 80%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--navy-line);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .nav:is([data-scrolled], [data-menu-open])::before {
    opacity: 1;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--nav-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .monogram {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--text-muted);
    border-radius: var(--radius-sm);
    color: var(--text);
  }
  .brand-name {
    display: none;
  }

  .menu-button {
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--text-muted);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text);
    font: 500 var(--fs-small) / 1 var(--font-sans);
    cursor: pointer;
    transition: border-color var(--dur-color) var(--ease-out);
  }
  .menu-button:hover {
    border-color: var(--accent);
  }

  /* Narrow screens: links live in a dropdown panel under the bar. */
  .links {
    display: none;
    position: absolute;
    top: 100%;
    inset-inline: 0;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--navy-line);
  }
  .nav[data-menu-open] .links {
    display: block;
  }
  .links ul {
    display: flex;
    flex-direction: column;
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-2) var(--gutter) var(--space-4);
    list-style: none;
  }
  .links a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text);
    font-size: var(--fs-small);
    text-decoration: none;
    transition: color var(--dur-color) var(--ease-out);
  }
  .links a:hover {
    color: var(--accent);
  }
  .links a[aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  /* Placeholder: looks like a button, does nothing yet, so no hover affordance. */
  .hint {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--text-muted);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: default;
  }
  .hint kbd {
    font: inherit;
    color: var(--text);
  }

  /* Keep in sync with the --nav-height breakpoint in tokens.css. */
  @media (min-width: 48rem) {
    .inner {
      gap: var(--space-6);
    }
    .brand {
      margin-right: auto;
    }
    .brand-name {
      display: inline;
    }
    .menu-button {
      display: none;
    }
    .links,
    .nav[data-menu-open] .links {
      display: block;
      position: static;
      background: none;
      border: 0;
    }
    .links ul {
      flex-direction: row;
      gap: var(--space-4);
      padding: 0;
    }
    .hint {
      display: inline-flex;
    }
  }
</style>
