---
/**
 * Small mono label for a tag. Static by default; `interactive` renders a toggle button
 * (used for filtering) where `selected` is exposed through aria-pressed and a leading marker.
 *
 * Props:
 * - label: tag text.
 * - interactive: render as a <button> toggle. Default false.
 * - selected: pressed state, only meaningful when interactive. Default false.
 * - class: extra classes on the root element.
 */
interface Props {
  label: string;
  interactive?: boolean;
  selected?: boolean;
  class?: string;
}

const {
  label,
  interactive = false,
  selected = false,
  class: className,
} = Astro.props;
const Element = interactive ? 'button' : 'span';
---

<Element
  class:list={['chip', { interactive }, className]}
  type={interactive ? 'button' : undefined}
  aria-pressed={interactive ? selected : undefined}
>
  {label}
</Element>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2rem;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--navy-line);
    border-radius: var(--radius-sm);
    background: transparent;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: var(--tracking-mono);
    line-height: 1;
    color: var(--text-muted);
  }

  .interactive {
    border-color: var(--text-muted);
    color: var(--text);
    cursor: pointer;
    transition: border-color var(--dur-color) var(--ease-out);
  }
  .interactive:hover {
    border-color: var(--accent);
  }

  /*
   * Selected state is driven by aria-pressed so scripts only flip one attribute. It is marked
   * by a square dot as well as colour, so it never relies on colour alone.
   */
  .interactive[aria-pressed='true'] {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: var(--accent);
  }
  .interactive[aria-pressed='true']::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--accent);
  }
</style>
