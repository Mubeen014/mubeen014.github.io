---
/**
 * Summary card for a project, role or degree. The whole card is one link (the title link is
 * stretched over it); tags are plain labels.
 *
 * Props:
 * - title, summary: card text.
 * - subtitle: optional line under the title.
 * - href: link target, already passed through `url()`.
 * - kind: "project" | "experience" | "education"; sets the kind marker colour.
 * - dateRange: display string such as "2023 – present".
 * - tags: tag labels.
 * - coords: optional mono readout shown on hover/focus, e.g. "z = [0.42, -1.17, 0.88]".
 * - placeholder: show the dev-only placeholder badge. Default false.
 * - headingLevel: 2 or 3 so the card title fits the page outline. Default 3.
 * Slots:
 * - cover: optional media shown edge to edge at the top of the card.
 * - class: extra classes on the root element.
 */
import TagChip from './TagChip.astro';
import PlaceholderBadge from './PlaceholderBadge.astro';
import type { EntryKind } from '../lib/entries';

interface Props {
  title: string;
  subtitle?: string | undefined;
  summary: string;
  href: string;
  kind: EntryKind;
  dateRange: string;
  tags: string[];
  coords?: string;
  placeholder?: boolean;
  headingLevel?: 2 | 3;
  class?: string;
}

const {
  title,
  subtitle,
  summary,
  href,
  kind,
  dateRange,
  tags,
  coords,
  placeholder = false,
  headingLevel = 3,
  class: className,
} = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<article class:list={['card', kind, className]}>
  {Astro.slots.has('cover') && (
    <div class="cover">
      <slot name="cover" />
    </div>
  )}
  <p class="meta mono">
    <span class="kind">{kind}</span>
    <span>{dateRange}</span>
    {placeholder && <PlaceholderBadge />}
  </p>
  <Heading class="title">
    <a href={href}>{title}</a>
  </Heading>
  {subtitle && <p class="subtitle">{subtitle}</p>}
  <p class="summary">{summary}</p>
  <ul class="tags" aria-label="Tags">
    {tags.map((tag) => (
      <li>
        <TagChip label={tag} />
      </li>
    ))}
  </ul>
  {coords && <p class="coords mono">{coords}</p>}
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-5);
    background: var(--bg-raised);
    border: 1px solid var(--navy-line);
    border-radius: var(--radius);
    transition:
      transform var(--dur-fast) var(--ease-out),
      border-color var(--dur-color) var(--ease-out);
  }

  .cover {
    aspect-ratio: 16 / 7;
    margin: calc(-1 * var(--space-5)) calc(-1 * var(--space-5)) 0;
    border-radius: calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0;
    border-bottom: 1px solid var(--navy-line);
    overflow: hidden;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .kind::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: var(--space-2);
    border-radius: 50%;
    background: var(--text-muted);
  }
  .project .kind::before {
    background: var(--point-project-rest);
  }
  .experience .kind::before {
    background: var(--point-experience);
  }
  .education .kind::before {
    background: var(--point-education);
  }

  .title {
    font-size: var(--fs-h3);
    line-height: 1.25;
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  /* Stretches the title link over the whole card. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .title a:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .subtitle {
    margin-top: calc(-1 * var(--space-2));
    font-size: var(--fs-small);
    color: var(--text);
  }

  .summary {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .coords {
    margin-top: auto;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .card:hover {
    transform: translateY(-2px);
  }
  .card:is(:hover, :has(a:focus-visible)) {
    border-color: var(--accent);
  }
  .card:is(:hover, :has(a:focus-visible)) .coords {
    opacity: 1;
  }
  .card:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    box-shadow: 0 0 0 8px var(--accent-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }
</style>
