---
/**
 * Layout for a single entry page (project, role or degree): header block, MDX body, then
 * prev/next links within the same collection. The nearest-neighbours block arrives in Phase 4.
 *
 * Props:
 * - kind: entry kind (eyebrow label and back link).
 * - title, summary: header text.
 * - dateRange: display string such as "Mar 2023 – present".
 * - subtitle: line under the title (project role, organisation details, or degree).
 * - tags: tag labels.
 * - links: external links rendered as secondary buttons (may be empty).
 * - placeholder: show the dev-only placeholder badge.
 * - previous, next: neighbouring entries in index order; undefined at the ends.
 * - coords: optional mono coordinate readout, e.g. "z = [0.42, -1.17, 0.88]".
 * Slots:
 * - cover: optional media shown between the header and the body.
 */
import BaseLayout from './BaseLayout.astro';
import TagChip from '../components/TagChip.astro';
import Button from '../components/Button.astro';
import PlaceholderBadge from '../components/PlaceholderBadge.astro';
import {
  indexPathForKind,
  type AdjacentLink,
  type EntryKind,
} from '../lib/entries';

interface Props {
  kind: EntryKind;
  title: string;
  summary: string;
  dateRange: string;
  subtitle: string;
  tags: string[];
  links: { label: string; href: string }[];
  placeholder: boolean;
  previous: AdjacentLink | undefined;
  next: AdjacentLink | undefined;
  coords?: string;
}

const {
  kind,
  title,
  summary,
  dateRange,
  subtitle,
  tags,
  links,
  placeholder,
  previous,
  next,
  coords,
} = Astro.props;
const indexLabel = {
  project: 'projects',
  experience: 'experience',
  education: 'education',
}[kind];
---

<BaseLayout title={title} description={summary}>
  <article class="container detail">
    <header class="header">
      <a class="back mono" href={indexPathForKind(kind)}>
        ← all {indexLabel}
      </a>
      <p class:list={['meta', 'mono', kind]}>
        <span class="kind">{kind}</span>
        <span>{dateRange}</span>
        {placeholder && <PlaceholderBadge />}
      </p>
      <h1>{title}</h1>
      <p class="subtitle">{subtitle}</p>
      <p class="summary">{summary}</p>
      <ul class="tags" aria-label="Tags">
        {tags.map((tag) => (
          <li>
            <TagChip label={tag} />
          </li>
        ))}
      </ul>
      {links.length > 0 && (
        <ul class="links" aria-label="Links">
          {links.map(({ label, href }) => (
            <li>
              <Button variant="secondary" href={href}>
                {label}
              </Button>
            </li>
          ))}
        </ul>
      )}
      {coords && <p class="coords mono">{coords}</p>}
    </header>
    {Astro.slots.has('cover') && (
      <div class="cover">
        <slot name="cover" />
      </div>
    )}
    <div class="prose">
      <slot />
    </div>
    <nav class="pager" aria-label={`More ${indexLabel}`}>
      {previous && (
        <a class="pager-link previous" href={previous.href} rel="prev">
          <span class="mono">← Newer</span>
          <span class="pager-title">{previous.title}</span>
        </a>
      )}
      {next && (
        <a class="pager-link next" href={next.href} rel="next">
          <span class="mono">Older →</span>
          <span class="pager-title">{next.title}</span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>

<style>
  .detail {
    padding-block: var(--space-7) 0;
  }
  .header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: var(--prose-width);
    margin-bottom: var(--space-7);
  }
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--accent);
    text-decoration: none;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }
  .kind::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: var(--space-2);
    border-radius: 50%;
    background: var(--text-muted);
  }
  .project .kind::before {
    background: var(--point-project);
  }
  .experience .kind::before {
    background: var(--point-experience);
  }
  .education .kind::before {
    background: var(--point-education);
  }
  .subtitle {
    margin-top: calc(-1 * var(--space-2));
    font-weight: 500;
  }
  .cover {
    aspect-ratio: 16 / 7;
    max-width: var(--prose-width);
    margin-bottom: var(--space-7);
    border: 1px solid var(--navy-line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .summary {
    font-size: var(--fs-h3);
    line-height: 1.4;
    color: var(--text-muted);
  }
  .tags,
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .prose {
    max-width: var(--prose-width);
  }
  .prose :global(* + *) {
    margin-top: var(--space-4);
  }
  .prose :global(h2) {
    margin-top: var(--space-7);
  }
  .prose :global(h3) {
    margin-top: var(--space-6);
  }
  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-top: var(--space-3);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-5);
  }
  .prose :global(li + li) {
    margin-top: var(--space-2);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    background: var(--bg-raised);
    border-radius: var(--radius-sm);
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
    max-width: var(--prose-width);
    margin-top: var(--space-8);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--navy-line);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition: border-color var(--dur-color) var(--ease-out);
  }
  .pager-link:hover {
    border-color: var(--accent);
  }
  .next {
    grid-column: -2;
    text-align: right;
  }
  .pager-title {
    font-weight: 600;
  }
</style>
