---
/** Role detail page, one per entry in the experience collection. */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DetailLayout from '../../layouts/DetailLayout.astro';
import {
  getAdjacentEntries,
  getEntry,
  getNearestNeighbours,
} from '../../lib/entries';
import { formatDateRange } from '../../lib/dates';

export async function getStaticPaths() {
  const roles = await getCollection('experience');
  return roles.map((role) => ({ params: { slug: role.id }, props: { role } }));
}

interface Props {
  role: CollectionEntry<'experience'>;
}

const { role } = Astro.props;
const { data } = role;
const { Content } = await render(role);
const { previous, next } = await getAdjacentEntries('experience', role.id);
const entry = await getEntry('experience', role.id);
const neighbours = await getNearestNeighbours(entry);
---

<DetailLayout
  kind="experience"
  title={data.position}
  summary={data.summary}
  dateRange={formatDateRange(data.startDate, data.endDate)}
  subtitle={`${data.organisation} · ${data.location} · ${data.employmentType}`}
  tags={data.tags}
  links={[]}
  placeholder={data.placeholder}
  previous={previous}
  next={next}
  coords={entry.coords}
  neighbours={neighbours}
>
  <Content />
</DetailLayout>
