---
/**
 * Home: hero (3D latent space over a static gradient, mounted after first paint), about,
 * featured projects, career timeline and contact.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import ProjectCover from '../components/ProjectCover.astro';
import Timeline from '../components/Timeline.astro';
import { getAllEntries, getProjectCovers } from '../lib/entries';
import { formatDateRange } from '../lib/dates';
import { siteConfig } from '../lib/site';
import { url } from '../lib/paths';
import {
  LATENT_SPACE_DATA_ID,
  serialiseLatentSpaceData,
  toLatentSpaceData,
} from '../lib/latent-space-data';

const entries = await getAllEntries();
const featuredProjects = entries.filter(
  (entry) => entry.kind === 'project' && entry.featured,
);
const career = entries.filter((entry) => entry.kind !== 'project');
const covers = await getProjectCovers();
const latentSpace = toLatentSpaceData(entries);
const latentSpaceJson = serialiseLatentSpaceData(latentSpace);

const facts = [
  { label: 'based in', value: '[TODO] City' },
  { label: 'focus', value: '[TODO] ML engineering' },
  { label: 'currently', value: '[TODO] Company A' },
];
---

<BaseLayout title="Home" description={`${siteConfig.name}: ${siteConfig.role}`}>
  <section class="hero" aria-labelledby="hero-name">
    <div class="hero-space" aria-hidden="true" data-latent-space></div>
    <script
      type="application/json"
      id={LATENT_SPACE_DATA_ID}
      set:html={latentSpaceJson}
    />
    <div class="container hero-content">
      <h1 id="hero-name" class="hero-name">
        {siteConfig.name}
      </h1>
      <p class="hero-role">{siteConfig.role}</p>
      <div class="hero-actions">
        <Button href={url('/projects/')}>View projects</Button>
        <Button variant="secondary" href={url('/#contact')}>
          Contact
        </Button>
      </div>
      <p class="hero-hint mono" aria-hidden="true">
        drag to orbit · <span class="hint-pointer">click</span>
        <span class="hint-touch">tap</span> a point to open
      </p>
    </div>
    <ul
      class="point-links"
      aria-label="Entries in the latent space"
      data-point-links
    >
      {latentSpace.points.map((point) => (
        <li>
          <a href={point.href} data-key={point.key}>
            {point.title}
            <span class="mono">
              {point.kind} · {point.year}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="container section" id="about" aria-labelledby="about-heading">
    <h2 id="about-heading">About</h2>
    <div class="about-copy">
      <p>
        [TODO] First paragraph: who you are and what you build, in one or two
        plain sentences.
      </p>
      <p>
        [TODO] Second paragraph: the kind of problems you like, and how
        engineering and machine learning meet in your work.
      </p>
      <p>
        [TODO] Third paragraph: what you are doing now and what you are looking
        for.
      </p>
    </div>
    <dl class="facts">
      {facts.map(({ label, value }) => (
        <div>
          <dt class="mono">{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section
    class="container section"
    id="projects"
    aria-labelledby="projects-heading"
  >
    <h2 id="projects-heading">Projects</h2>
    <ul class="grid">
      {featuredProjects.map((project) => (
        <li>
          <Card
            title={project.title}
            summary={project.summary}
            href={project.href}
            kind="project"
            dateRange={formatDateRange(project.startDate, project.endDate)}
            tags={project.tags}
            coords={project.coords}
            placeholder={project.placeholder}
          >
            <ProjectCover
              slot="cover"
              tags={project.tags}
              cover={covers.get(project.id)}
              variant="card"
            />
          </Card>
        </li>
      ))}
    </ul>
    <a class="more" href={url('/projects/')}>
      All projects →
    </a>
  </section>

  <section
    class="container section"
    id="career"
    aria-labelledby="career-heading"
  >
    <h2 id="career-heading">Experience &amp; education</h2>
    <Timeline entries={career} />
    <p class="more-links">
      <a href={url('/experience/')}>All experience →</a>
      <a href={url('/education/')}>All education →</a>
    </p>
  </section>

  <section
    class="container section contact"
    id="contact"
    aria-labelledby="contact-heading"
  >
    <h2 id="contact-heading">Contact</h2>
    <p class="contact-copy">
      [TODO] One or two sentences inviting people to get in touch, and about
      what.
    </p>
    <div class="hero-actions">
      <Button href={`mailto:${siteConfig.email}`}>{siteConfig.email}</Button>
      <Button variant="secondary" href={siteConfig.githubUrl}>
        GitHub
      </Button>
      <Button variant="secondary" href={siteConfig.linkedinUrl}>
        LinkedIn
      </Button>
    </div>
  </section>
</BaseLayout>

<script>
  /**
   * Loads the 3D latent space after the page has loaded, so the hero text paints (and is
   * the LCP element) before any WebGL code is fetched.
   */
  import {
    LATENT_SPACE_DATA_ID,
    parseLatentSpaceData,
  } from '../lib/latent-space-data';

  const container = document.querySelector<HTMLElement>('[data-latent-space]');
  const linkList = document.querySelector<HTMLElement>('[data-point-links]');
  const json = document.getElementById(LATENT_SPACE_DATA_ID)?.textContent;
  if (!container || !linkList || !json) {
    throw new Error(
      'Home: latent space container, link list or data not found',
    );
  }
  const data = parseLatentSpaceData(json);

  const start = () =>
    requestAnimationFrame(async () => {
      const { mountLatentSpace } =
        await import('../scripts/latent-space/scene');
      mountLatentSpace(container, data, linkList);
    });
  if (document.readyState === 'complete') {
    start();
  } else {
    window.addEventListener('load', start, { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    margin-top: calc(
      -1 * var(--nav-height)
    ); /* sit under the transparent nav */
    padding-block: calc(var(--nav-height) + var(--space-7)) var(--space-8);
    overflow: hidden;
    isolation: isolate; /* keeps the canvas (z-index -1) inside the hero and hit-testable */
  }
  /* Static gradient shows at first paint; the canvas fades in over it once rendered. */
  .hero-space {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 70% 35%, var(--accent-soft), transparent 35%),
      radial-gradient(circle at 60% 45%, var(--navy-line), transparent 55%),
      radial-gradient(circle at 20% 80%, var(--bg-raised), transparent 60%),
      var(--bg);
  }
  .hero-space :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .hero-space[data-ready] :global(canvas) {
    opacity: 1;
  }
  .hero-content {
    pointer-events: none; /* drags over the text area still reach the canvas */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .hero-name {
    font-size: var(--fs-hero);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .hero-role {
    max-width: 36ch;
    font-size: var(--fs-h3);
    line-height: 1.4;
    color: var(--text-muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
    pointer-events: auto;
  }
  .hero-hint {
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .hero:has([data-ready]) .hero-hint {
    opacity: 1;
  }
  .hint-touch {
    display: none;
  }
  @media not ((hover: hover) and (pointer: fine)) {
    .hint-pointer {
      display: none;
    }
    .hint-touch {
      display: inline;
    }
  }

  /* Label card for the highlighted point (created by labels.ts). */
  .hero-space :global(.latent-label) {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 16rem;
    padding: var(--space-3) var(--space-4);
    background: color-mix(in srgb, var(--bg-raised) 92%, transparent);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .hero-space :global(.latent-label[data-visible]) {
    opacity: 1;
    pointer-events: auto;
  }
  .hero-space :global(.latent-label-title) {
    font-weight: 600;
    line-height: 1.25;
  }

  /*
   * Keyboard path: links mirroring every point. Visually hidden until focused; the focused
   * link appears as a chip at the top of the hero while its point is highlighted.
   */
  .point-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .point-links a:not(:focus-visible) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .point-links a:focus-visible {
    position: absolute;
    top: calc(var(--nav-height) + var(--space-4));
    left: max(
      var(--gutter),
      calc((100% - var(--container)) / 2 + var(--gutter))
    );
    z-index: 2;
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-2) var(--space-4);
    background: var(--bg-raised);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: var(--space-9);
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--prose-width);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-7);
    margin: 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--navy-line);
  }
  .facts dd {
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .more {
    align-self: flex-start;
  }
  .more-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
  }

  .contact-copy {
    max-width: var(--prose-width);
    color: var(--text-muted);
  }
</style>
