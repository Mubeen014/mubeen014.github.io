---
/**
 * Projects index: static 2D scatter of the projects (same embedding as the home page),
 * then a single-select tag filter over the card grid ("All" by default; tapping the active
 * tag clears it). Hovering or focusing a card highlights its point and vice versa; the
 * filter dims points of hidden projects.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import TagChip from '../../components/TagChip.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import Scatter2D from '../../components/Scatter2D.astro';
import { getEntriesOfKind, getProjectCovers } from '../../lib/entries';
import { formatDateRange } from '../../lib/dates';

const projects = await getEntriesOfKind('project');
const covers = await getProjectCovers();
const allTags = [
  ...new Set(projects.flatMap((project) => project.tags)),
].sort();
---

<BaseLayout
  title="Projects"
  description="Projects, case studies and experiments."
>
  <div class="container page">
    <header class="page-header">
      <h1>Projects</h1>
      <p class="intro">Case studies and experiments, newest first.</p>
    </header>

    <div class="map">
      <Scatter2D points={projects} />
    </div>

    <div class="filter">
      <p class="mono" id="filter-label">
        filter by tag
      </p>
      <ul class="chips" aria-labelledby="filter-label" data-tag-filter>
        <li data-tag="">
          <TagChip label="All" interactive selected />
        </li>
        {allTags.map((tag) => (
          <li data-tag={tag}>
            <TagChip label={tag} interactive />
          </li>
        ))}
      </ul>
      <p class="mono status" aria-live="polite" data-filter-status>
        showing {projects.length} of {projects.length}
      </p>
    </div>

    <ul class="grid" data-project-list>
      {projects.map((project) => (
        <li data-tags={project.tags.join(' ')} data-key={project.key}>
          <Card
            title={project.title}
            summary={project.summary}
            href={project.href}
            kind="project"
            dateRange={formatDateRange(project.startDate, project.endDate)}
            tags={project.tags}
            coords={project.coords}
            placeholder={project.placeholder}
            headingLevel={2}
          >
            <ProjectCover
              slot="cover"
              tags={project.tags}
              cover={covers.get(project.id)}
              variant="card"
            />
          </Card>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<script>
  /**
   * Single-select tag filter ("All" = empty tag shows everything) and card <-> scatter
   * point highlighting.
   */
  const filterList = document.querySelector<HTMLElement>('[data-tag-filter]');
  const projectList = document.querySelector<HTMLElement>(
    '[data-project-list]',
  );
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  if (!filterList || !projectList || !status) {
    throw new Error('Projects page: filter, list or status element not found');
  }
  const chipItems = [
    ...filterList.querySelectorAll<HTMLElement>('li[data-tag]'),
  ];
  const projectItems = [
    ...projectList.querySelectorAll<HTMLElement>('li[data-key]'),
  ];
  const scatterPoints = new Map(
    [
      ...document.querySelectorAll<HTMLElement>('[data-scatter] [data-key]'),
    ].map((point) => [point.dataset['key'] ?? '', point]),
  );
  let activeTag = '';

  const applyFilter = () => {
    for (const chipItem of chipItems) {
      const pressed = chipItem.dataset['tag'] === activeTag;
      chipItem
        .querySelector('button')
        ?.setAttribute('aria-pressed', String(pressed));
    }
    let visibleCount = 0;
    for (const item of projectItems) {
      const tags = (item.dataset['tags'] ?? '').split(' ');
      const visible = activeTag === '' || tags.includes(activeTag);
      item.hidden = !visible;
      scatterPoints
        .get(item.dataset['key'] ?? '')
        ?.toggleAttribute('data-dimmed', !visible);
      visibleCount += visible ? 1 : 0;
    }
    status.textContent = `showing ${visibleCount} of ${projectItems.length}`;
  };

  filterList.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('button'))
      return;
    const tag =
      event.target.closest<HTMLElement>('li[data-tag]')?.dataset['tag'];
    if (tag === undefined) return;
    // Tapping the active tag clears the filter back to "All".
    activeTag = tag === activeTag ? '' : tag;
    applyFilter();
  });

  const setLinked = (key: string, linked: boolean) => {
    scatterPoints.get(key)?.toggleAttribute('data-active', linked);
    projectItems
      .find((item) => item.dataset['key'] === key)
      ?.classList.toggle('linked', linked);
  };
  for (const item of projectItems) {
    const key = item.dataset['key'] ?? '';
    item.addEventListener('mouseenter', () => setLinked(key, true));
    item.addEventListener('mouseleave', () => setLinked(key, false));
    item.addEventListener('focusin', () => setLinked(key, true));
    item.addEventListener('focusout', () => setLinked(key, false));
  }
  for (const [key, point] of scatterPoints) {
    point.addEventListener('mouseenter', () => setLinked(key, true));
    point.addEventListener('mouseleave', () => setLinked(key, false));
  }
</script>

<style>
  .page {
    padding-block: var(--space-7) 0;
  }
  .page-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .intro {
    color: var(--text-muted);
  }
  .map {
    margin-bottom: var(--space-6);
  }
  .filter {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grid li[hidden] {
    display: none;
  }
  .grid li.linked :global(.card) {
    border-color: var(--accent);
  }
</style>
