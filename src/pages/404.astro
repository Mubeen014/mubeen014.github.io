---
/** Not-found page. GitHub Pages serves the built 404.html for any unknown path. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { url } from '../lib/paths';
---

<BaseLayout
  title="Out of distribution"
  description="This page isn't in the training set."
>
  <div class="container not-found">
    <p class="mono">404 · p(x) ≈ 0</p>
    <h1>Out of distribution.</h1>
    <p class="intro">This page isn't in the training set.</p>
    <div class="actions">
      <Button href={url('/')}>Back to the latent space</Button>
      <Button variant="secondary" href={url('/projects/')}>
        View projects
      </Button>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: var(--space-9) 0;
  }
  .intro {
    font-size: var(--fs-h3);
    color: var(--text-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
</style>
